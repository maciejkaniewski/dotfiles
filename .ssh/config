# ── SSH client configuration ────────────────────────────────────────────────
# ~/.ssh/config links here. Hosts of one profile (machines at work, say) are
# in ~/.ssh/config.local, which install.sh copies from .ssh/config.local.<profile>.
# It is read first, and ssh keeps the first value it finds for each option, so
# it can override anything below.
Include config.local

Host *
    # Notice a dead link (Wi-Fi drop, suspend) after ~45s and exit, instead of
    # leaving the session frozen until TCP gives up.
    ServerAliveInterval 15
    # Ubuntu's /etc/ssh/ssh_config hashes known_hosts, which leaves Tab
    # completion no host names to offer. New entries are stored in plain text.
    HashKnownHosts no
