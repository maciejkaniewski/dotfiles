# ── Work machine SSH hosts ──────────────────────────────────────────────────
# install.sh copies this to ~/.ssh/config.local for the work profile. Add hosts
# only one machine needs to that copy; add hosts every work machine needs here.

# Machines on the local network, reached by IP or by mDNS name.
Host *.local 192.168.*
    # Uncomment to log in as one user by default; a user@ you type still wins.
    # User <user>
    # Record a new or reflashed machine's key without asking. A key that changed
    # for a host already in known_hosts is still refused.
    StrictHostKeyChecking accept-new
