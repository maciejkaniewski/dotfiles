// Waybar's module definitions and bar layout, shared by both bars in
// config.jsonc (each includes this file): the main bar and the slim side bars.
{
    "layer": "bottom",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,

    "group/system": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "custom/io", "custom/thermal", "custom/serial"]
    },
    // The controls, an island for each kind: apps' tray icons (the tray, in
    // config.jsonc, is an island of its own), connections, the screen, sound,
    // and power.
    "group/connect": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth"]
    },
    "group/screen": {
        "orientation": "horizontal",
        "modules": ["idle_inhibitor", "custom/night-light"]
    },
    "group/sound": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "pulseaudio#mic"]
    },
    "group/power": {
        "orientation": "horizontal",
        "modules": ["power-profiles-daemon", "battery", "battery#time", "custom/power"]
    },

    // Each workspace's name or number, then an icon per window on it (from
    // window-rewrite, matched on app ID; other apps get a plain window icon).
    "niri/workspaces": {
        "format": "{value} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "",
        "window-rewrite": {
            "app_id<kitty>": "",
            "app_id<.*[Cc]ode.*>": "󰨞",
            "app_id<.*[Ff]irefox.*>": "󰈹",
            "app_id<.*([Cc]hrome|[Cc]hromium).*>": "",
            // Slack: a dot on its icon while anything is unread (its title starts
            // with *), a red one for mentions (!). Slack sends no unread count
            // outside Ubuntu's own dock, so there is no number to show.
            "app_id<.*slack.*> title<!": "󰒱<span size='small' rise='5pt' foreground='#f38ba8'>●</span>",
            "app_id<.*slack.*> title<\\*": "󰒱<span size='small' rise='5pt'>●</span>",
            "app_id<.*slack.*> title<(?![*!])": "󰒱",
            "app_id<.*[Tt]hunderbird.*>": "󰇮",
            "app_id<([Tt]hunar|org.gnome.Nautilus)>": "󰉋",
            "app_id<Angry IP Scanner>": "󰌘",
            "app_id<org.gnome.Settings>": "󰒓",
            "app_id<org.gnome.Calculator>": "󰃬"
        }
    },

    // A red pill while a call shares the screen or a window, or something
    // records it (.local/bin/waybar-cast); hidden otherwise.
    "custom/cast": {
        "exec": "waybar-cast",
        "return-type": "json",
        "restart-interval": 5
    },

    // What's playing (Spotify, a browser tab: anything that speaks MPRIS),
    // hidden when nothing is. Click to play or pause, right-click for the
    // next track, middle-click for the previous; scrolling skips too.
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 30,
        "player-icons": {
            "default": "󰎆",
            "spotify": "󰓇",
            "firefox": "󰈹",
            "chromium": "󰊯",
            "chrome": "󰊯"
        },
        "status-icons": { "paused": "󰏤" },
        "tooltip-format": "{player}: {title}\n{artist}  {album}",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },

    // From .local/bin/waybar-calendar rather than Waybar's clock, whose calendar
    // can't colour weekends. Hover for the month: weeks start on Monday,
    // Saturday and Sunday are red.
    "custom/clock": {
        "exec": "waybar-calendar",
        "return-type": "json",
        "interval": 10
    },

    "cpu": {
        "interval": 5,
        "format": " {usage}% {avg_frequency}GHz",
        "tooltip-format": "CPU {usage}%, {min_frequency}–{max_frequency} GHz across cores",
        "on-click": "kitty --title btop -e btop"
    },
    "memory": {
        "interval": 5,
        "format": "  {used:0.1f} / {total:0.0f}G",
        "tooltip-format": "Memory {used:0.1f} / {total:0.1f} GB ({percentage}%)\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GB",
        "on-click": "kitty --title btop -e btop"
    },
    // How full / is; hover for free space and the network's speed
    // (.local/bin/waybar-io). Click for the disks (duf) and what takes the
    // space in your home folder (dust), in a floating kitty.
    "custom/io": {
        "exec": "waybar-io",
        "return-type": "json",
        "restart-interval": 10,
        "on-click": "kitty --title disk --hold sh -c 'duf --only local --hide-fs squashfs,tmpfs,vfat; echo; dust -d 1 -n 15 ~'"
    },
    // CPU temperature and the fan speed beside it (.local/bin/waybar-thermal);
    // the fan is left out on machines without a sensor for it.
    "custom/thermal": {
        "exec": "waybar-thermal",
        "return-type": "json",
        "restart-interval": 10
    },

    // USB serial adapters: how many are plugged in (hidden when none); hover
    // lists them, click opens `ports -w` to watch them come and go.
    "custom/serial": {
        "exec": "ports --waybar",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "kitty --title ports -e ports -w"
    },
    // Apps' own icons (Slack and the like). It hides while it has none.
    "tray": {
        "spacing": 8
    },
    // Wi-Fi's signal, or the cable while on one; hover for the network and
    // address. Click for nearby networks in fuzzel (.local/bin/wifi-menu),
    // which ends with GNOME Settings' Wi-Fi page. The download and upload
    // speeds are in the disk readout's tooltip (custom/io). nm-applet isn't
    // started (.config/autostart/nm-applet.desktop), so its icon doesn't add
    // a second Wi-Fi to the tray.
    "network": {
        "interval": 5,
        "format-wifi": "{icon}",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Offline",
        "on-click": "wifi-menu"
    },
    // Keep awake: while on, the idle lock and screen-off don't happen.
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
        "tooltip-format-activated": "Staying awake (click to allow idle lock)",
        "tooltip-format-deactivated": "Idle lock on (click to stay awake)"
    },
    // Night light (.local/bin/night-light): the moon, yellow while the screen is
    // warm and grey while it isn't. Click to switch it on or off now, overriding the
    // schedule; right-click for a warmth slider and the schedule's times, with
    // a button back to the schedule after such a click; scrolling steps the
    // warmth too. The minute interval catches the schedule's turns; a click
    // updates it at once (signal 8).
    "custom/night-light": {
        "exec": "night-light",
        "return-type": "json",
        "interval": 60,
        "signal": 8,
        "on-click": "night-light --toggle",
        "on-click-right": "night-light --slider",
        "on-scroll-up": "night-light --warmer",
        "on-scroll-down": "night-light --cooler"
    },
    // Hover for the connected devices. Click for the paired ones in fuzzel, to
    // connect or disconnect (.local/bin/bluetooth-menu), which ends with
    // bluetui in a floating kitty, to pair a new one.
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "bluetooth-menu"
    },
    // Click for pulsemixer; right-click to pick where sound plays, or mute
    // (.local/bin/sound-output).
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
        "tooltip-format": "{desc}",
        "on-click": "kitty --title pulsemixer -e pulsemixer",
        "on-click-right": "sound-output"
    },
    // The mic, red and crossed out while muted; click to mute or unmute,
    // through .local/bin/osd for its pop-up, as the mic-mute key does.
    // Scrolling does nothing, so a call's mic can't change by accident.
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "tooltip-format": "{source_desc}",
        "on-click": "osd mic mute",
        "on-scroll-up": "",
        "on-scroll-down": ""
    },
    // GNOME's power modes (power-profiles-daemon, which runs in any session).
    // Click for the next mode, right-click for the previous one.
    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆",
            "default": "󰾅"
        },
        "tooltip-format": "Power mode: {profile}\nClick for the next one"
    },
    "battery": {
        "interval": 30,
        "states": { "warning": 20, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}",
        // The exact draw in the tooltip; smoothed, so the time left doesn't
        // jump about between readings.
        "tooltip-format-discharging": "Drawing {power:.1f} W\n{timeTo}",
        "tooltip-format-charging": "Charging at {power:.1f} W\n{timeTo}",
        "smooth-power": true
    },
    // The time left on battery, or to full while charging, in brackets after
    // the charge and in the text colour rather than the battery's green
    // (style.css); nothing when plugged in and full.
    "battery#time": {
        "interval": 30,
        "format": "",
        // The brackets are part of the time, so nothing shows while there's
        // no estimate yet (the first moments after plugging or unplugging).
        "format-discharging": "{time}",
        "format-charging": "{time}",
        "format-time": "({H}:{m})",
        "smooth-power": true,
        "tooltip": false
    },
    // A red microphone by the clock while any app records from a mic, hidden
    // otherwise; hover names the app. Screen sharing has its own pill
    // (custom/cast), so only audio-in here.
    "privacy": {
        "icon-size": 14,
        "modules": [{"type": "audio-in", "tooltip-icon-size": 20}]
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Lock, suspend, log out, reboot or shut down",
        "on-click": "power-menu"
    }
}
