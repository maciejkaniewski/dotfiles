// Waybar: the bar along the top of the niri session, as rounded islands on a
// transparent bar: workspaces on the left, the clock in the middle, system
// readouts and controls on the right, all on one rounded translucent bar.
// Values are short; hover for details.
// Under niri, kitty's tab bar leaves these readouts to Waybar and keeps only
// the host and IP of the window. Super+B hides and shows the bar.
{
    // The bottom layer zooms out with the workspaces in niri's overview
    // (Super+O) instead of staying full size on top of it. Tiled windows
    // still leave its space free, and fullscreen ones cover it.
    "layer": "bottom",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,

    "modules-left": ["niri/workspaces"],
    "modules-center": ["custom/clock"],
    "modules-right": ["group/system", "group/controls"],

    "group/system": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "temperature", "network", "custom/serial"]
    },
    "group/controls": {
        "orientation": "horizontal",
        "modules": ["tray", "idle_inhibitor", "bluetooth", "pulseaudio", "power-profiles-daemon", "battery", "custom/power"]
    },

    // A named workspace's name (workspace "1" in the niri config), otherwise its number.
    "niri/workspaces": {
        "format": "{value}"
    },

    // From .local/bin/waybar-calendar rather than Waybar's clock, whose calendar
    // can't colour weekends. Hover for the month: weeks start on Monday,
    // Saturday and Sunday are red.
    "custom/clock": {
        "exec": "waybar-calendar",
        "return-type": "json",
        "interval": 10
    },

    "cpu": {
        "interval": 5,
        "format": "󰍛 {usage}% {avg_frequency}GHz",
        "tooltip-format": "CPU {usage}%, {min_frequency}–{max_frequency} GHz across cores",
        "on-click": "kitty --title btop -e btop"
    },
    "memory": {
        "interval": 5,
        "format": "󰍺 {percentage}%",
        "tooltip-format": "Memory {used:0.1f} / {total:0.1f} GB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GB",
        "on-click": "kitty --title btop -e btop"
    },
    // coretemp is Intel's CPU sensor; set k10temp on an AMD machine.
    "temperature": {
        "interval": 5,
        "hwmon-name": "coretemp",
        "input-filename": "temp1_input",
        "critical-threshold": 90,
        "format": "󰔏 {temperatureC}°",
        "tooltip-format": "CPU package {temperatureC} °C"
    },
    "network": {
        "interval": 5,
        "format-wifi": "{icon}",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid}  {signaldBm} dBm\n{ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Offline",
        "on-click": "kitty --title nmtui -e nmtui"
    },

    // USB serial adapters: how many are plugged in (hidden when none); hover
    // lists them, click opens `ports -w` to watch them come and go.
    "custom/serial": {
        "exec": "ports --waybar",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "kitty --title ports -e ports -w"
    },
    "tray": {
        "spacing": 8
    },
    // Keep awake: while on, the idle lock and screen-off don't happen.
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
        "tooltip-format-activated": "Staying awake (click to allow idle lock)",
        "tooltip-format-deactivated": "Idle lock on (click to stay awake)"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Bluetooth {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "kitty --title bluetui -e bluetui"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
        "tooltip-format": "{desc}",
        "on-click": "kitty --title pulsemixer -e pulsemixer",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    // GNOME's power modes (power-profiles-daemon, which runs in any session).
    // Click for the next mode, right-click for the previous one.
    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆",
            "default": "󰾅"
        },
        "tooltip-format": "Power mode: {profile}\nClick for the next one"
    },
    "battery": {
        "interval": 30,
        "states": { "warning": 20, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Lock, suspend, log out, reboot or shut down",
        "on-click": "power-menu"
    }
}
