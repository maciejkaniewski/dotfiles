// Waybar: rounded islands along the top of each screen. One screen gets the
// main bar (workspaces, clock, system readouts, tray, controls), the others a
// slim one with just their workspaces and the clock. .local/bin/waybar-launch
// starts Waybar with $WAYBAR_MAIN set to the main screen; Super+Shift+B makes
// the focused screen the main one, and undocked, the laptop's screen takes
// over. Super+B hides and shows the bars. Under niri, kitty's tab bar leaves
// the system readouts to Waybar and keeps only the window's host and IP.
//
// The bottom layer zooms out with the workspaces in niri's overview (Super+O)
// instead of staying full size on top of it; tiled windows still leave its
// space free, and fullscreen ones cover it. Modules: modules.jsonc.
[
    {
        "name": "main",
        "output": "$WAYBAR_MAIN",
        "include": ["~/.config/waybar/modules.jsonc"],
        "modules-left": ["niri/workspaces"],
        "modules-center": ["custom/clock"],
        "modules-right": ["group/system", "group/controls"]
    },
    {
        "name": "side",
        "output": ["!$WAYBAR_MAIN", "*"],
        "include": ["~/.config/waybar/modules.jsonc"],
        "modules-left": ["niri/workspaces"],
        "modules-center": ["custom/clock"],
        "modules-right": []
    }
]
