// Gruvbox Dark for niri. The theme picker links ~/.config/niri/theme.kdl here.
layout {
    focus-ring {
        active-gradient from="#83a598" to="#d3869b" angle=45 relative-to="workspace-view"
        inactive-color "#928374"
        urgent-color "#fb4934"
    }
    shadow {
        color "#1d2021aa"
    }
}

overview {
    backdrop-color "#1d2021"
}

// The focused window glows softly in the accent colour. Floating windows
// keep the deeper drop shadow config.kdl gives them instead.
window-rule {
    match is-focused=true is-floating=false
    shadow {
        on
        softness 30
        spread 2
        offset x=0 y=0
        color "#83a59830"
    }
}

// The Alt+Tab switcher's highlight behind the chosen window.
recent-windows {
    highlight {
        active-color "#83a59880"
        urgent-color "#fb493480"
    }
}

// A window shared in a call (or recorded) is outlined in red, so it's clear
// what others can see. A shared screen isn't outlined; Waybar shows a red
// "sharing" pill for that (.local/bin/waybar-cast).
window-rule {
    match is-window-cast-target=true
    // A border rather than the focus ring, which is only drawn on the
    // focused window: this stays when you click away to another window.
    focus-ring {
        off
    }
    border {
        on
        width 2
        active-color "#fb4934"
        inactive-color "#fb4934c0"
    }
    shadow {
        on
        color "#fb493450"
    }
}
