// Gruvbox Dark for niri. The theme picker links ~/.config/niri/theme.kdl here.
layout {
    focus-ring {
        active-gradient from="#83a598" to="#d3869b" angle=45 relative-to="workspace-view"
        inactive-color "#928374"
        urgent-color "#fb4934"
    }
    shadow {
        color "#1d2021aa"
    }
}

overview {
    backdrop-color "#1d2021"
}

// The focused window glows softly in the accent colour.
window-rule {
    match is-focused=true
    shadow {
        on
        softness 30
        spread 2
        offset x=0 y=0
        color "#83a59830"
    }
}
