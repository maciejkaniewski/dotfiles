// Catppuccin Frappé for niri. The theme picker links ~/.config/niri/theme.kdl here.
layout {
    focus-ring {
        active-gradient from="#babbf1" to="#ca9ee6" angle=45 relative-to="workspace-view"
        inactive-color "#737994"
        urgent-color "#e78284"
    }
    shadow {
        color "#232634aa"
    }
}

overview {
    backdrop-color "#232634"
}

// The focused window glows softly in the accent colour.
window-rule {
    match is-focused=true
    shadow {
        on
        softness 40
        spread 6
        offset x=0 y=0
        color "#babbf155"
    }
}
