// Catppuccin Macchiato for niri. The theme picker links ~/.config/niri/theme.kdl here.
layout {
    focus-ring {
        active-gradient from="#b7bdf8" to="#c6a0f6" angle=45 relative-to="workspace-view"
        inactive-color "#6e738d"
        urgent-color "#ed8796"
    }
    shadow {
        color "#181926aa"
    }
}

overview {
    backdrop-color "#181926"
}

// The focused window glows softly in the accent colour.
window-rule {
    match is-focused=true
    shadow {
        on
        softness 30
        spread 2
        offset x=0 y=0
        color "#b7bdf830"
    }
}
