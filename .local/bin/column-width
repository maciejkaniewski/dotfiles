#!/usr/bin/env bash
# column-width: Super+= / Super+- in the niri session. Widens or narrows the
# focused column by 10% of the screen, like set-column-width "+10%", but
# stops at full width: niri itself lets a column grow past the screen.
#
#   column-width up|down

dir=${1:-}
case $dir in
    up) step=+10% ;;
    down) step=-10% ;;
    *) echo "usage: column-width up|down" >&2; exit 2 ;;
esac
[[ $dir == down ]] && exec niri msg action set-column-width "$step"

# The gaps, from the layout block.
config=${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl
gaps=$(awk '/^layout[[:space:]]*\{/ { inl = 1 } inl && /^\}/ { inl = 0 }
    inl && $1 == "gaps" { g = $2 } END { print (g == "" ? 16 : g) }' "$config")

# A floating window: niri's own step.
width=$(niri msg -j focused-window | jq -r 'select(.is_floating == false) | .layout.tile_size[0] // empty')
screen=$(niri msg -j focused-output | jq -r '.logical.width // empty')
[[ -n $width && -n $screen ]] || exec niri msg action set-column-width "$step"

# The column's width as a proportion of the screen, the way niri counts it (a
# proportion p of a screen W wide with gaps g is a tile (W - g)p - g wide).
# Already full: nothing. Less than a step from full: exactly full.
step=$(awk -v w="$width" -v s="$screen" -v g="$gaps" -v step="$step" 'BEGIN {
    p = (w + g) / (s - g); e = 2 / s
    if (p >= 1 - e) exit
    print (p + 0.1 >= 1 - e ? "100%" : step) }')
[[ -z $step ]] || niri msg action set-column-width "$step"
