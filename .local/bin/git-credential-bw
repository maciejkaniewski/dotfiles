#!/usr/bin/env bash
# git credential helper backed by the Bitwarden CLI (git config: helper = bw).
#
# Read-only by design: it hands git a username and password out of an already
# unlocked vault and nothing else. `store` and `erase` are no-ops, so nothing
# is ever written to the vault or to disk, and a wrong credential is never
# "remembered" anywhere.
#
# Silent unless it is certain: a locked vault, no match, or an ambiguous match
# prints nothing on stdout, so git falls back to its normal username/password
# prompt. Ambiguity is refused rather than guessed — taking the first of two
# matches could send a personal token to the work host, or the reverse.
#
# Unlock first with `bwu` (see .zshrc); BW_SESSION is the only secret involved
# and lives in that shell's environment, never in a file.

[[ "$1" == get ]] || exit 0

say() { printf 'git-credential-bw: %s\n' "$*" >&2; }

command -v bw &>/dev/null || exit 0
command -v jq &>/dev/null || { say "jq is required"; exit 0; }

# git sends key=value lines up to a blank line.
protocol= host= username=
while IFS='=' read -r key value; do
  [[ -z "$key" ]] && break
  case "$key" in
    protocol) protocol=$value ;;
    host)     host=$value ;;
    username) username=$value ;;
  esac
done

[[ "$protocol" == http || "$protocol" == https ]] || exit 0
[[ -n "$host" ]] || exit 0

# No session means a locked vault. Say why, then let git prompt as usual.
# bw reads BW_SESSION from the environment itself; passing --session would put
# the key in the process list. --nointeraction below: git owns stdin, so bw
# must never ask for anything itself.
if [[ -z "$BW_SESSION" ]]; then
  say "vault is locked — run 'bwu' to unlock (falling back to the normal prompt)"
  exit 0
fi

# host:port as git passes it; match on the hostname alone, since Bitwarden
# URIs are normally written without a port.
hostname=${host%:*}

# `bw list items --url` uses Bitwarden's URI matching, which by default
# compares the base domain. That would return every item under the company
# domain (SSO, Jira, ...) for gitlab.<company>.com, so the exact-hostname
# filter below is the real selector; --url only narrows the list.
items=$(bw list items --nointeraction --url "$protocol://$host" 2>/dev/null) || {
  say "bw failed (session expired? run 'bwu')"
  exit 0
}

matches=$(jq -c --arg host "$hostname" --arg user "$username" '
  [ .[]
    | select(.type == 1 and .login.password != null and .login.password != "")
    | select(any(.login.uris[]?; (.uri // "") | test("^https?://" + ($host | gsub("\\."; "\\.")) + "(:[0-9]+)?(/|$)")))
    | select($user == "" or .login.username == $user)
  ]' <<<"$items" 2>/dev/null) || exit 0

count=$(jq 'length' <<<"$matches")

# The site's ordinary web login shares the host with the token item, so two
# matches is the normal case, not an edge case. A name starting "git:" (or
# "git ") marks the one meant for git; without it, ambiguity is still refused.
if (( count > 1 )); then
  narrowed=$(jq -c '[.[] | select(.name | test("^git[: ]"; "i"))]' <<<"$matches" 2>/dev/null) || exit 0
  # Only adopt the narrowed list if it found something; otherwise keep the
  # ambiguous one so the refusal below explains itself instead of staying silent.
  if (( $(jq 'length' <<<"$narrowed") > 0 )); then
    matches=$narrowed
    count=$(jq 'length' <<<"$matches")
  fi
fi

case "$count" in
  1) ;;
  0) exit 0 ;;
  *) say "$count logins match $hostname$([[ -n "$username" ]] && echo " as $username") — leaving it to git to prompt. Name the one for git \"git: <host>\", or set credential.username for this host"
     exit 0 ;;
esac

user=$(jq -r '.[0].login.username // ""' <<<"$matches")
pass=$(jq -r '.[0].login.password' <<<"$matches")

# A newline in either value would let it inject extra credential fields.
if [[ "$user" == *$'\n'* || "$pass" == *$'\n'* ]]; then
  say "refusing a login containing a newline"
  exit 0
fi

# `bw list items` can return a login with no username; git needs one.
[[ -n "$user" ]] || { say "matching login has no username"; exit 0; }

printf 'username=%s\npassword=%s\n' "$user" "$pass"
