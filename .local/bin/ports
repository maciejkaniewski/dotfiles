#!/usr/bin/env bash
# ports — list the USB serial adapters plugged in, follow them being plugged
# in and out, or share them on the network.
#
# Listing comes from udev and /sys, so it needs no root and nothing beyond
# udevadm. Only USB serial ports are listed: ttyS* and other built-in ttys
# are not adapters.
#
# Sharing runs the ser2net that install.sh --ser2net builds from source, as a
# systemd service serving each shared adapter as an RFC 2217 port on its own
# TCP port, which another machine opens as rfc2217://<this host>:<port>. Its
# config is generated, never edited by hand: `share` and `unshare` rewrite
# /etc/ser2net.yaml with one connection per shared adapter, with what must not
# be left out fixed here: telnet(rfc2217), so the client can set the baud rate
# and send BREAKs, and tcp(nodelay), without which ser2net holds back the
# second half of any reply longer than one FTDI USB packet (62 bytes) until
# the client ACKs the first, and reads time out. A change reloads ser2net
# rather than restarting it, so clients of the other shares stay connected.
# Sharing survives a reboot: the first share enables the service, the last
# unshare disables it.

SHARE_CONFIG=/etc/ser2net.yaml
SHARE_MARK='# Written by ports share'
SHARE_UNIT=/etc/systemd/system/ser2net.service
SHARE_FIRST_PORT=4000

usage() {
  cat <<'EOF'
Usage: ports                         list USB serial ports, and those shared on the network
       ports -w                      list them, then print a line per plug and unplug (Ctrl-C stops)
       ports --notify                a desktop notification per plug and unplug (the niri session runs it)
       ports --waybar                Waybar's serial-port readout: a JSON line now and after each change
       ports share DEVICE [PORT]     share DEVICE on TCP PORT too, now and at boot, or move it to PORT
       ports unshare DEVICE|PORT     stop sharing that one; the others stay shared
       ports unshare [--all]         stop sharing all of them (bare: only when one is shared)

ttyUSB1 means /dev/ttyUSB1; an alias or a /dev/serial/by-id path works too.
PORT defaults to the one DEVICE is already shared on, else the first free
from 4000.
EOF
}

# Colours from the theme install.sh --theme picked (~/.config/theme/current),
# in the same roles as the prompt: blue for the device, as for the directory,
# green/yellow/red for good/warn/bad, the theme's comment grey for secondary
# text. Dracula has no blue, so cyan takes that role there, as in its p10k
# file. No theme file falls back to the terminal's 16 colours; piped output
# is plain text.
theme_colours() {
  local family variant hex
  [[ -r $HOME/.config/theme/current ]] && read -r family variant < "$HOME/.config/theme/current"
  #        text   dim    blue   green  red    yellow peach  mauve  teal
  case "$family-$variant" in
    catppuccin-frappe)    hex=(c6d0f5 838ba7 8caaee a6d189 e78284 e5c890 ef9f76 ca9ee6 81c8be) ;;
    catppuccin-macchiato) hex=(cad3f5 8087a2 8aadf4 a6da95 ed8796 eed49f f5a97f c6a0f6 8bd5ca) ;;
    catppuccin-mocha)     hex=(cdd6f4 7f849c 89b4fa a6e3a1 f38ba8 f9e2af fab387 cba6f7 94e2d5) ;;
    gruvbox-dark)         hex=(ebdbb2 928374 83a598 b8bb26 fb4934 fabd2f fe8019 d3869b 8ec07c) ;;
    dracula-*)            hex=(f8f8f2 6272a4 8be9fd 50fa7b ff5555 f1fa8c ffb86c bd93f9 ff79c6) ;;
    *)
      TEXT='' DIM=$'\e[2m' BLUE=$'\e[34m' GREEN=$'\e[32m' RED=$'\e[31m'
      YELLOW=$'\e[33m' PEACH=$'\e[33m' MAUVE=$'\e[35m' TEAL=$'\e[36m'
      return ;;
  esac
  local -a c
  local h
  for h in "${hex[@]}"; do
    c+=("$(printf '\e[38;2;%d;%d;%dm' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}")")
  done
  TEXT=${c[0]} DIM=${c[1]} BLUE=${c[2]} GREEN=${c[3]} RED=${c[4]}
  YELLOW=${c[5]} PEACH=${c[6]} MAUVE=${c[7]} TEAL=${c[8]}
}

if [[ -t 1 ]]; then
  BOLD=$'\e[1m' RESET=$'\e[0m'
  theme_colours
else
  BOLD='' RESET='' TEXT='' DIM='' BLUE='' GREEN='' RED='' YELLOW='' PEACH='' MAUVE='' TEAL=''
fi

# 1 ms is what the udev rule sets; anything else is worth noticing.
latency_colour() {
  case $1 in
    "1 ms") printf '%s' "$GREEN" ;;
    —)      printf '%s' "$DIM" ;;
    *)      printf '%s' "$PEACH" ;;
  esac
}

declare -A P   # udev properties of the device being described

# Loads one tty's udev properties into P.
load_props() {
  local k v
  P=()
  while IFS='=' read -r k v; do
    [[ -n "$k" ]] && P[$k]=$v
  done < <(udevadm info -q property -n "$1" 2>/dev/null)
}

# Prints the USB ttys, one /dev path per line, in name order.
usb_ttys() {
  local t
  for t in /sys/class/tty/*; do
    [[ "$(readlink -f "$t")" == */usb* ]] && echo "/dev/${t##*/}"
  done | sort -V
}

# Pads $1 with spaces to $2 characters. printf's own %-*s pads to a byte
# count, which comes up short on anything non-ASCII, such as the — placeholder.
pad() { printf '%s%*s' "$1" $(( $2 - ${#1} )) ''; }

# Describes the device in P as tab-separated fields:
# device, product, serial, driver, latency, USB port, stable path, aliases.
describe() {
  local name=${P[DEVNAME]##*/} product serial driver latency port path link aliases=()

  # The product string from the USB descriptor, which vendors often set to
  # something telling ("CP2102N USB to UART Bridge Controller"); ID_MODEL has
  # its spaces replaced.
  product=$(printf '%b' "${P[ID_MODEL_ENC]:-${P[ID_MODEL]:-?}}")
  product=${product%"${product##*[![:space:]]}"}
  # FT2232 and FT4232 expose one tty per channel; name the channel.
  if [[ ${P[ID_VENDOR_ID]} == 0403 && ${P[ID_MODEL_ID]} =~ ^(6010|6011)$ && -n ${P[ID_USB_INTERFACE_NUM]} ]]; then
    local channels=(A B C D)
    product+=" (${channels[10#${P[ID_USB_INTERFACE_NUM]}]})"
  fi

  serial=${P[ID_SERIAL_SHORT]:-—}
  driver=${P[ID_USB_DRIVER]:-—}

  # Only ftdi_sio exposes it; read at call time, after udev's rules have run.
  if [[ -r /sys/class/tty/$name/device/latency_timer ]]; then
    latency="$(< "/sys/class/tty/$name/device/latency_timer") ms"
  else
    latency=—
  fi

  # The USB port is the part of the device path before the interface
  # (…/3-1/3-1:1.0/ttyUSB0 → 3-1); hubs add dotted levels (3-1.2).
  [[ ${P[DEVPATH]} =~ /([0-9]+-[0-9.]+):[0-9]+\.[0-9]+/ ]] && port=${BASH_REMATCH[1]} || port=—

  # by-id stays the same whichever USB port the adapter is in and whatever
  # ttyUSB number it gets; by-path is next best for adapters without a serial.
  # Any link outside /dev/serial is a name a local udev rule gave the port
  # (SYMLINK+="debug-uart").
  path=${P[DEVNAME]}
  for link in ${P[DEVLINKS]}; do
    case $link in
      /dev/serial/by-id/*)   [[ $path == /dev/serial/by-id/* ]] || path=$link ;;
      /dev/serial/by-path/*) [[ $path == /dev/serial/* ]] || path=$link ;;
      *)                     aliases+=("$link") ;;
    esac
  done
  link=$(IFS=,; echo "${aliases[*]}")

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${P[DEVNAME]}" "$product" "$serial" "$driver" "$latency" "$port" "$path" "${link//,/, }"
}

# Prints a table of every USB serial port, or a dim note when there are none,
# then where the shared one is reached from, while one is shared.
list() {
  local dev port rows=() shares=()
  local -A shared_on   # resolved device → TCP port
  while IFS= read -r dev; do
    load_props "$dev"
    rows+=("$(describe)")
  done < <(usb_ttys)
  if systemctl is-active --quiet ser2net 2>/dev/null; then
    mapfile -t shares < <(shared)
    for dev in "${shares[@]}"; do
      read -r port dev _ <<<"$dev"
      shared_on[$(readlink -f "$dev")]=$port
    done
  fi

  if (( ${#rows[@]} == 0 )); then
    echo "${DIM}No USB serial ports${RESET}"
    if (( ${#shares[@]} )); then echo; share_summary "${shares[@]}"; fi
    return 0
  fi

  # Widths of DEVICE PRODUCT SERIAL DRIVER LATENCY PORT, then ALIAS (field 7),
  # which is shown only when some port has one, and SHARED, shown only while
  # something is shared — matched by the device it resolves to, so a by-id
  # path in the config still marks its ttyUSB.
  local -a w=(6 7 6 6 7 4 0 5)
  local row i f alias_head='' alias_cell share_head='' share_cell
  for row in "${rows[@]}"; do
    IFS=$'\t' read -ra f <<<"$row"
    for i in 0 1 2 3 4 5 7; do (( ${#f[i]} > w[i] )) && w[i]=${#f[i]}; done
    [[ -n ${f[7]} ]] && alias_head=1
  done
  [[ -n $alias_head ]] && alias_head="$(pad ALIAS "${w[7]}")  "
  (( ${#shares[@]} )) && share_head="$(pad SHARED 6)  "

  # Colours go outside each padded field, so escapes don't count as width.
  echo "${DIM}${BOLD}$(pad DEVICE "${w[0]}")  ${alias_head}$(pad PRODUCT "${w[1]}")  $(pad SERIAL "${w[2]}")  $(pad DRIVER "${w[3]}")  $(pad LATENCY "${w[4]}")  $(pad PORT "${w[5]}")  ${share_head}STABLE PATH${RESET}"
  for row in "${rows[@]}"; do
    IFS=$'\t' read -ra f <<<"$row"
    alias_cell='' share_cell=''
    [[ -n $alias_head ]] && alias_cell="${BLUE}$(pad "${f[7]:-—}" "${w[7]}")${RESET}  "
    if [[ -n $share_head ]]; then
      port=${shared_on[$(readlink -f "${f[0]}")]}
      if [[ -n $port ]]; then
        share_cell="${GREEN}${BOLD}$(pad ":$port" 6)${RESET}  "
      else
        share_cell="${DIM}$(pad — 6)${RESET}  "
      fi
    fi
    echo "${BLUE}${BOLD}$(pad "${f[0]}" "${w[0]}")${RESET}  ${alias_cell}${TEXT}$(pad "${f[1]}" "${w[1]}")${RESET}  ${YELLOW}$(pad "${f[2]}" "${w[2]}")${RESET}  ${MAUVE}$(pad "${f[3]}" "${w[3]}")${RESET}  $(latency_colour "${f[4]}")$(pad "${f[4]}" "${w[4]}")${RESET}  ${TEAL}$(pad "${f[5]}" "${w[5]}")${RESET}  ${share_cell}${DIM}${f[6]}${RESET}"
  done
  # An if, not `(( … )) &&`: as the last command, a false test with nothing
  # shared became list's status, and ports exited 1 after a good listing.
  if (( ${#shares[@]} )); then echo; share_summary "${shares[@]}"; fi
}

# ── Sharing ───────────────────────────────────────────────────────────────────

share_die() { echo "${RED}✗${RESET} $*" >&2; exit 1; }

# The source build and its unit, from install.sh --ser2net. apt's ser2net is
# deliberately not enough: its 4.6.0 never answers an RFC 2217 PURGE-DATA,
# which older clients wait for.
share_need_ser2net() {
  [[ -x /usr/local/sbin/ser2net && -f $SHARE_UNIT ]] \
    || share_die "ser2net is not set up — run ./install.sh --ser2net in the dotfiles"
}

# What the current config shares as RFC 2217, one "PORT DEVICE NAME" line per
# enabled connection, by port; NAME is ser2net's name for the connection.
shared() {
  [[ -r $SHARE_CONFIG ]] || return
  awk '
    function flush() { if (port != "" && dev != "" && !off) print port, dev, name; port = dev = ""; off = 0 }
    /^connection:/ { flush(); name = $2; sub(/^&/, "", name) }
    /^[[:space:]]+enable:[[:space:]]*off/ { off = 1 }
    /accepter:.*telnet\(rfc2217\)/ { n = split($0, a, ","); port = a[n]; gsub(/[^0-9]/, "", port) }
    /connector:.*serialdev/ { split($0, b, ","); dev = b[2]; gsub(/[[:space:]]/, "", dev) }
    END { flush() }' "$SHARE_CONFIG" | sort -n
}

# Whether $1 and $2 name the same device: the same path, or links to one.
same_dev() { [[ $1 == "$2" || $(readlink -f "$1") == "$(readlink -f "$2")" ]]; }

# Whether anything listens on TCP port $1.
listening() { ss -ltnH "( sport = :$1 )" 2>/dev/null | grep -q .; }

# One "LABEL ADDRESS" line per network this host is on, Ethernet first: a
# cable has far less delay and jitter than Wi-Fi, and over Wi-Fi a remote
# bench sees timeouts. Container bridges and loopback are left out.
addresses() {
  local ifname addr kind label
  while read -r _ ifname _ addr _; do
    case $ifname in lo|docker*|br-*|veth*|virbr*) continue ;; esac
    if [[ -d /sys/class/net/$ifname/wireless ]]; then kind=2 label=Wi-Fi
    elif [[ $ifname == tun* || $ifname == wg* || $ifname == tailscale* ]]; then kind=3 label=VPN
    else kind=1 label=Ethernet
    fi
    echo "$kind $label ${addr%/*}"
  done < <(ip -4 -o addr show) | sort -n | cut -d' ' -f2-
}

# The addresses of the clients connected to TCP port $1, comma-separated.
clients() {
  ss -tnH state established "( sport = :$1 )" 2>/dev/null \
    | awk '{ p = $NF; sub(/:[0-9]+$/, "", p); gsub(/^\[(::ffff:)?|\]$/, "", p); print p }' \
    | sort -u | paste -sd, - | sed 's/,/, /g'
}

# Where each share ("PORT DEVICE" per argument) is reached from, and who has
# it. The addresses are this host's first network, Ethernet when there is
# one; the others are named below.
share_summary() {
  local boot first='' first_label='' label addr s port dev note peers dw=0 uw=0
  local -a others=()
  boot=$(systemctl is-enabled ser2net 2>/dev/null)
  while read -r label addr; do
    if [[ -z $first ]]; then first=$addr first_label=$label; else others+=("$label $addr"); fi
  done < <(addresses)
  [[ -n $first ]] || first=localhost first_label="this machine only"
  for s; do
    read -r port dev _ <<<"$s"
    (( ${#dev} > dw )) && dw=${#dev}
    s="rfc2217://$first:$port"
    (( ${#s} > uw )) && uw=${#s}
  done

  echo "${GREEN}●${RESET} Shared on the network over ${BOLD}$first_label${RESET}  ${DIM}($([[ $boot == enabled ]] && echo "also after a reboot" || echo "until a reboot"); ser2net $(/usr/local/sbin/ser2net -v 2>/dev/null | grep -oP '\d+\.\d+\.\d+'))${RESET}"
  for s; do
    read -r port dev _ <<<"$s"
    if ! listening "$port"; then
      note="${RED}✗ nothing listens — see: journalctl -u ser2net -n 20${RESET}"
    elif [[ ! -c $dev ]]; then
      note="${YELLOW}! not plugged in${RESET}"
    elif peers=$(clients "$port"); [[ -n $peers ]]; then
      note="${MAUVE}connected:${RESET} $peers"
    else
      note="${DIM}nobody connected${RESET}"
    fi
    echo "  ${BLUE}${BOLD}$(pad "$dev" "$dw")${RESET}  ${TEAL}$(pad "rfc2217://$first:$port" "$uw")${RESET}  $note"
  done
  for s in "${others[@]}"; do
    echo "  ${DIM}Also on ${s%% *} as ${s#* }, same ports${RESET}"
  done
  echo "  ${DIM}One client per port: whoever connects last takes it.${RESET}"
}

# Writes the config: one connection per "PORT DEVICE [NAME [off]]" argument,
# named port<PORT> unless NAME is given, and disabled when "off" follows.
write_config() {
  local s port dev name state

  # Whatever was there first (Debian's examples, or a hand-written config) is
  # kept once, beside it, before the first rewrite.
  if [[ -e $SHARE_CONFIG ]] && ! grep -qF "$SHARE_MARK" "$SHARE_CONFIG" && [[ ! -e $SHARE_CONFIG.orig ]]; then
    sudo cp "$SHARE_CONFIG" "$SHARE_CONFIG.orig" || share_die "could not back up $SHARE_CONFIG"
    echo "${DIM}Kept the previous config as $SHARE_CONFIG.orig${RESET}"
  fi

  {
    cat <<EOF
%YAML 1.1
---
$SHARE_MARK: it rewrites this file, \`ports unshare\` stops sharing.
# telnet(rfc2217): the client sets the baud rate and sends BREAKs.
# tcp(nodelay): without it, replies longer than one FTDI USB packet are held
# back until the client ACKs, and reads time out.
EOF
    for s; do
      read -r port dev name state <<<"$s"
      cat <<EOF

connection: &${name:-port$port}
    accepter: telnet(rfc2217),tcp(nodelay),$port
    enable: ${state:-on}
    options:
      kickolduser: true
    connector: serialdev,$dev,3000000n81,local
EOF
    done
  } | sudo tee "$SHARE_CONFIG" >/dev/null || share_die "could not write $SHARE_CONFIG"
}

# Makes ser2net reread the config. Unlike a restart, this leaves the
# connections that did not change, and their clients, alone.
reload_ser2net() {
  sudo systemctl kill --kill-whom=main --signal=HUP ser2net || share_die "could not reload ser2net"
  sleep 0.5
}

# Shares exactly the "PORT DEVICE" arguments: none stops ser2net, now and at
# boot. While it runs, a connection that goes away is first disabled, which
# kicks its client off and frees the adapter and the TCP port; deleted
# outright, ser2net would keep it until the client disconnects.
apply_shares() {
  local -a keep=() off=()
  local port dev name s

  if (( $# == 0 )); then
    write_config
    sudo systemctl disable --quiet --now ser2net || share_die "could not stop ser2net"
    return
  fi

  if systemctl is-active --quiet ser2net; then
    while read -r port dev name; do
      for s; do
        [[ $s == "$port $dev" && $name == "port$port" ]] && { keep+=("$s"); continue 2; }
      done
      off+=("$port $dev $name off")
    done < <(shared)
    if (( ${#off[@]} )); then
      write_config "${keep[@]}" "${off[@]}"
      reload_ser2net
    fi
    write_config "$@"
    reload_ser2net
  else
    write_config "$@"
    sudo systemctl enable --quiet ser2net && sudo systemctl restart ser2net \
      || share_die "ser2net did not start — see: journalctl -u ser2net -n 20"
    sleep 0.5
  fi
}

# Shares $1 on TCP port $2 as well as whatever is shared already, or moves it
# there when it is shared on another.
share() {
  local dev=$1 port=$2 p d cur='' s
  local -a want=()
  share_need_ser2net
  [[ -n $dev ]] || share_die "share which? e.g. \`ports share ttyUSB1\` — \`ports\` lists what is plugged in"
  [[ $dev == /* ]] || dev=/dev/$dev
  [[ -c $dev ]] || share_die "$dev is not a serial device — \`ports\` lists what is plugged in"
  [[ -z $port ]] || { [[ $port =~ ^[0-9]+$ ]] && (( port > 0 && port < 65536 )); } || share_die "$port is not a TCP port"

  while read -r p d _; do
    if same_dev "$d" "$dev"; then cur=$p; continue; fi
    [[ $p == "$port" ]] && share_die "port $port already shares $d — pick another, or \`ports unshare $port\` first"
    want+=("$p $d")
  done < <(shared)

  if [[ -z $port ]]; then
    port=${cur:-$SHARE_FIRST_PORT}
    if [[ -z $cur ]]; then
      while listening "$port" || printf '%s\n' "${want[@]}" | grep -q "^$port "; do (( port++ )); done
    fi
  elif [[ $port != "$cur" ]] && listening "$port"; then
    share_die "something else already listens on port $port — pick another"
  fi

  want+=("$port $dev")
  mapfile -t want < <(printf '%s\n' "${want[@]}" | sort -n)
  apply_shares "${want[@]}"
  list
}

# Stops sharing $1, a device or a TCP port, or all of them for --all.
# Without $1, stops the only share, and asks which when there are several.
unshare() {
  local target=$1 p d s gone=''
  local -a all=() want=()
  share_need_ser2net
  mapfile -t all < <(shared)

  if [[ -z $target ]]; then
    if (( ${#all[@]} > 1 )); then
      echo "${RED}✗${RESET} ${#all[@]} are shared — say which, or all of them:" >&2
      for s in "${all[@]}"; do
        read -r p d _ <<<"$s"
        echo "    ports unshare ${d#/dev/}    ${DIM}(port $p)${RESET}" >&2
      done
      echo "    ports unshare --all" >&2
      exit 1
    fi
    target=--all
  fi

  if [[ $target == --all || $target == all ]]; then
    apply_shares
    echo "${DIM}○${RESET} Not shared — the adapters are this machine's alone again"
    return
  fi

  [[ $target =~ ^[0-9]+$ || $target == /* ]] || target=/dev/$target
  for s in "${all[@]}"; do
    read -r p d _ <<<"$s"
    if [[ $p == "$target" ]] || same_dev "$d" "$target"; then gone="$d on port $p"; else want+=("$p $d"); fi
  done
  [[ -n $gone ]] || share_die "${target#/dev/} is not shared — \`ports\` shows what is"

  apply_shares "${want[@]}"
  echo "${DIM}○${RESET} Stopped sharing $gone"
  if (( ${#want[@]} )); then echo; list; fi
}

# Column widths for -w lines, indexed like describe's fields (0 device,
# 1 product, 2 serial, 3 driver, 4 latency, 7 alias). Lines print one at a
# time, so they can't be sized from the whole list the way the table is.
# widen only ever grows a column: lines already printed stay aligned with
# every later one unless a longer value turns up. The alias column appears
# once some port has an alias, blank for those without.
W=([0]=12 [1]=17 [2]=8 [3]=8 [4]=4 [7]=0)
widen() {
  local -a f
  local i
  IFS=$'\t' read -ra f <<<"$1"
  for i in 0 1 2 3 4 7; do (( ${#f[i]} > W[i] )) && W[i]=${#f[i]}; done
}

# The device, alias, product and serial cells of a -w line, padded to W.
event_cells() {
  local -a f
  local out
  IFS=$'\t' read -ra f <<<"$1"
  out="${BLUE}${BOLD}$(pad "${f[0]}" "${W[0]}")${RESET}  "
  (( W[7] )) && out+="${BLUE}$(pad "${f[7]}" "${W[7]}")${RESET}  "
  out+="${TEXT}$(pad "${f[1]}" "${W[1]}")${RESET}  ${YELLOW}$(pad "${f[2]}" "${W[2]}")${RESET}"
  printf '%s' "$out"
}

# One line per udev add/remove of a USB tty. A remove is described from what
# was seen when it was added (or listed at start), since by then the device
# is gone from /sys.
watch_ports() {
  local -A seen
  local dev line k v f

  list
  while IFS= read -r dev; do
    load_props "$dev"
    seen[$dev]=$(describe)
    widen "${seen[$dev]}"
  done < <(usb_ttys)
  echo
  echo "${DIM}Watching for plug and unplug — Ctrl-C to stop${RESET}"

  # udevadm prints each event as KEY=value lines ending in a blank line. Only
  # udev's events: the kernel's arrive before the rules (and the latency
  # timer) have run, and carry no ID_* properties.
  P=()
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      [[ "$line" == *=* ]] && { k=${line%%=*} v=${line#*=}; P[$k]=$v; }
      continue
    fi
    if [[ -n ${P[DEVNAME]} && ${P[DEVPATH]} == */usb* ]]; then
      dev=${P[DEVNAME]}
      case ${P[ACTION]} in
        add)
          seen[$dev]=$(describe)
          widen "${seen[$dev]}"
          IFS=$'\t' read -ra f <<<"${seen[$dev]}"
          printf "${DIM}%(%H:%M:%S)T${RESET}  ${GREEN}${BOLD}+${RESET} %s  ${MAUVE}%s${RESET}  %s%s${RESET}  ${TEAL}USB port %s${RESET}\n" \
            -1 "$(event_cells "${seen[$dev]}")" "$(pad "${f[3]}" "${W[3]}")" \
            "$(latency_colour "${f[4]}")" "$(pad "${f[4]}" "${W[4]}")" "${f[5]}"
          ;;
        remove)
          [[ -n ${seen[$dev]} ]] || { seen[$dev]=$(describe); widen "${seen[$dev]}"; }
          printf "${DIM}%(%H:%M:%S)T${RESET}  ${RED}${BOLD}−${RESET} %s\n" -1 "$(event_cells "${seen[$dev]}")"
          unset "seen[$dev]"
          ;;
      esac
    fi
    P=()
  done < <(stdbuf -oL udevadm monitor --udev --property --subsystem-match=tty)
}

# One notification line for the device described in $1: tty, alias, product.
notify_line() {
  local -a f
  local alias product
  IFS=$'\t' read -ra f <<<"$1"
  alias=${f[7]//\/dev\//}
  product=${f[1]//&/&amp;}; product=${product//</&lt;}; product=${product//>/&gt;}
  printf '<b>%s</b>%s  %s' "${f[0]##*/}" "${alias:+  $alias}" "$product"
}

# Desktop notifications for plug and unplug, for a desktop session to run in
# the background: the niri config starts it at login. The ttys of one
# multi-channel adapter (FT2232: two, FT4232: four) arrive together, so events
# are gathered until half a second passes without one, then sent as one
# notification per kind. A second instance in the same session exits at once.
notify_ports() {
  command -v notify-send >/dev/null || { echo "notify-send is missing (apt install libnotify-bin)" >&2; exit 1; }
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ports-notify.lock"
  flock -n 9 || exit 0

  local -A seen
  local -a added=() removed=()
  local dev line k v rc

  send() {
    local title=$1; shift
    (( $# > 1 )) && title=${title/port/ports}
    notify-send -a ports -i drive-removable-media-usb "$title" "$(printf '%s\n' "$@")"
  }

  while IFS= read -r dev; do
    load_props "$dev"
    seen[$dev]=$(describe)
  done < <(usb_ttys)

  P=()
  while :; do
    if (( ${#added[@]} + ${#removed[@]} )); then
      IFS= read -r -t 0.5 line; rc=$?
      if (( rc > 128 )); then
        (( ${#added[@]} ))   && send "Serial port connected" "${added[@]}"
        (( ${#removed[@]} )) && send "Serial port disconnected" "${removed[@]}"
        added=() removed=()
        continue
      fi
      (( rc == 0 )) || break
    else
      IFS= read -r line || break
    fi
    if [[ -n "$line" ]]; then
      [[ "$line" == *=* ]] && { k=${line%%=*} v=${line#*=}; P[$k]=$v; }
      continue
    fi
    if [[ -n ${P[DEVNAME]} && ${P[DEVPATH]} == */usb* ]]; then
      dev=${P[DEVNAME]}
      case ${P[ACTION]} in
        add)
          seen[$dev]=$(describe)
          added+=("$(notify_line "${seen[$dev]}")")
          ;;
        remove)
          [[ -n ${seen[$dev]} ]] && removed+=("$(notify_line "${seen[$dev]}")")
          unset "seen[$dev]"
          ;;
      esac
    fi
    P=()
  done < <(stdbuf -oL udevadm monitor --udev --property --subsystem-match=tty)
}

# Waybar's readout of the USB serial ports: one JSON line now, then a new one
# after each burst of plug or unplug events, so Waybar polls nothing. The text
# is a count, empty (which hides the module) when nothing is plugged in; the
# tooltip lists each port as the notifications do.
waybar_ports() {
  local line dev count pending=false rc
  local -a lines

  emit() {
    lines=()
    while IFS= read -r dev; do
      load_props "$dev"
      lines+=("$(notify_line "$(describe)")")
    done < <(usb_ttys)
    count=${#lines[@]}
    local tooltip text=""
    (( count )) && text=" $count"
    tooltip=$(printf '%s\n' "${lines[@]}"); tooltip=${tooltip%$'\n'}
    tooltip=${tooltip//\\/\\\\}; tooltip=${tooltip//\"/\\\"}; tooltip=${tooltip//$'\n'/\\n}
    printf '{"text": "%s", "tooltip": "%s", "class": "%s"}\n' "$text" "$tooltip" "$( (( count )) && echo present || echo none)"
  }

  emit
  P=()
  while :; do
    if $pending; then
      IFS= read -r -t 0.5 line; rc=$?
      (( rc > 128 )) && { emit; pending=false; continue; }
      (( rc == 0 )) || break
    else
      IFS= read -r line || break
    fi
    if [[ -n "$line" ]]; then
      [[ "$line" == *=* ]] && { P[${line%%=*}]=${line#*=}; }
      continue
    fi
    [[ ${P[DEVPATH]} == */usb* && ${P[ACTION]} =~ ^(add|remove)$ ]] && pending=true
    P=()
  done < <(stdbuf -oL udevadm monitor --udev --property --subsystem-match=tty)
}

case $1 in
  "")         list ;;
  -w|--watch) watch_ports ;;
  --notify)   notify_ports ;;
  --waybar)   waybar_ports ;;
  share)      share "$2" "$3" ;;
  unshare)    unshare "$2" ;;
  -h|--help)  usage ;;
  *)          usage >&2; exit 2 ;;
esac
