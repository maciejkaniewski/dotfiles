# Tool versions ./install.sh --setup installs exactly, upgrading or downgrading
# to match. They mirror the firmware release CI image, so a local build uses
# the same compilers and formatters as a release build.
#
# Override any of them on one machine in ~/.config/dotfiles/versions (same
# format, untracked). "latest" in either file tracks upstream instead. LLVM can
# also be set with ./install.sh --llvm, which writes ~/.config/llvm/version.

llvm=18.1.8        # clangd, clang-format, clang-tidy, lld; firmware builds and release CI accept only this clang-format
clang=19           # the clang/clang++ compiler (apt clang-19); C23 constexpr needs 19 or newer
arm-gcc=15.3.rel1  # Arm GNU Toolchain release; its GCC reports 15.3.1
cmake=4.4.2
ninja=1.13.2
ruff=0.16.1        # formatter output changes between releases; projects require exactly this one
