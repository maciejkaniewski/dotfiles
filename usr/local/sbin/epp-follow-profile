#!/bin/sh
# Re-applies EPP whenever power-profiles-daemon switches profile — from the
# panel, Waybar, powerprofilesctl or a script. udev only sees the charger, so
# without this a profile change would wait for the next plug-in to take effect.
/usr/local/sbin/set-epp
gdbus monitor --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles |
  while read -r line; do
    case $line in *"'ActiveProfile'"*) /usr/local/sbin/set-epp ;; esac
  done
