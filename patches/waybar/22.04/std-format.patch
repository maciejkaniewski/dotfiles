Ubuntu 22.04 only: its gcc 11 has no std::format. This is the one use of it
that the date library doesn't stand in for, in the Hyprland language module
(unused here, but always built); fmt, which Waybar already uses, has the same
call. install.sh applies patches/waybar/22.04/ only on Ubuntu before 24.04.

diff --git a/src/modules/hyprland/language.cpp b/src/modules/hyprland/language.cpp
index 51b25af..752a272 100644
--- a/src/modules/hyprland/language.cpp
+++ b/src/modules/hyprland/language.cpp
@@ -188,7 +188,7 @@ void Language::initLanguage() {
   try {
     auto searcher = kbName.empty()
                         ? inputDevices
-                        : inputDevices.substr(inputDevices.find(std::format("\t{}\n", kbName)) +
+                        : inputDevices.substr(inputDevices.find(fmt::format("\t{}\n", kbName)) +
                                               kbName.length() + 2);
     searcher = searcher.substr(searcher.find("keymap:") + 8);
     searcher = searcher.substr(0, searcher.find_first_of("\n\t"));
